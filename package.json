{
  "name": "visione",
  "productName": "VISIONE",
  "version": "1.1.0-beta.41",
  "description": "VISIONE — sistema multi-agente locale (Electron + core separato)",
  "author": "matte",
  "private": true,
  "license": "GPL-3.0-only",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "app": "electron .",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && node tools/nsis-testi.mjs && electron-builder --win --x64",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "node tools/check-boundaries.mjs && node tools/check-repo.mjs",
    "test": "vitest run",
    "test:e2e": "electron-vite build && vitest run --config vitest.e2e.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "voice:models": "node tools/voice-models.mjs",
    "sensors:fetch": "node tools/sensors.mjs fetch",
    "sensors:start": "node tools/sensors.mjs start",
    "sensors:check": "node tools/sensors.mjs check",
    "check": "npm run typecheck && npm run lint && npm test && node tools/check-docs.mjs"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@huggingface/tokenizers": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "onnxruntime-node": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sherpa-onnx-node": "1.13.8",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
